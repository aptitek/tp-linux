{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Provisionner / Mettre à jour le poste (Chocolatey + WSL2 + Docker + Mise + Taskfile)",
      "type": "shell",
      "command": "bash ./setup.sh",
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/setup.ps1"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Démarrer / Dépauser Docker Desktop et le conteneur TP Linux (task local:up)",
      "type": "shell",
      "command": "bash ./scripts/ensure-docker.sh && task local:up",
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "& \"${workspaceFolder}/scripts/ensure-docker.ps1\"; if ($LASTEXITCODE -eq 0) { task local:up }"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Vérifier l'environnement et la qualité (task verify)",
      "type": "shell",
      "command": "task verify",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
