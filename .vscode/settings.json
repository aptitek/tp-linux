{
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.profiles.linux": {
    "fish": {
      "path": "/usr/bin/fish",
      "args": ["-l"],
      "icon": "terminal-linux"
    },
    "bash": {
      "path": "/usr/bin/bash",
      "args": ["-l"],
      "icon": "terminal-bash"
    }
